// Prisma Schema for Xoom Mart
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RIDER
  CUSTOMER
}

enum OrderStatus {
  PLACED
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED
  BUNDLE
}

enum LinkType {
  ITEM
  CATEGORY
  SHOP
  EXTERNAL
}

enum SectionType {
  HERO
  CATEGORIES
  DEALS
  POPULAR
  SHOPS
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String?
  email        String?  @unique
  role         UserRole
  passwordHash String?  @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  ordersAsRider Order[]

  @@map("users")
}

model Category {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  iconUrl      String?  @map("icon_url")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id           String   @id @default(uuid())
  categoryId   String   @map("category_id")
  name         String
  slug         String   @unique
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items    Item[]

  @@map("subcategories")
}

model Item {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  subcategoryId   String   @map("subcategory_id")
  price           Decimal  @db.Decimal(10, 2)
  discountPrice   Decimal? @map("discount_price") @db.Decimal(10, 2)
  discountPercent Int?     @map("discount_percent")
  images          Json     @default("[]")
  isAvailable     Boolean  @default(true) @map("is_available")
  stockQuantity   Int      @default(0) @map("stock_quantity")
  tags            Json     @default("[]")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  subcategory Subcategory  @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  shopItems   ShopItem[]
  orderItems  OrderItem[]

  @@index([subcategoryId])
  @@index([isActive])
  @@map("items")
}

model Shop {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  category          String?
  address           String?  @db.Text
  locationLat       Decimal? @map("location_lat") @db.Decimal(10, 8)
  locationLng       Decimal? @map("location_lng") @db.Decimal(11, 8)
  deliveryFee       Decimal  @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  estimatedDelivery Int      @default(30) @map("estimated_delivery")
  isOpen            Boolean  @default(true) @map("is_open")
  isActive          Boolean  @default(true) @map("is_active")
  bannerUrl         String?  @map("banner_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  shopItems ShopItem[]
  orders    Order[]

  @@map("shops")
}

model ShopItem {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  itemId      String   @map("item_id")
  shopPrice   Decimal? @map("shop_price") @db.Decimal(10, 2)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([shopId, itemId])
  @@index([shopId])
  @@index([itemId])
  @@map("shop_items")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  customerPhone   String      @map("customer_phone")
  customerName    String?     @map("customer_name")
  deliveryAddress String      @map("delivery_address") @db.Text
  shopId          String?     @map("shop_id")
  riderId         String?     @map("rider_id")
  status          OrderStatus @default(PLACED)
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @map("delivery_fee") @db.Decimal(10, 2)
  platformFee     Decimal     @default(0) @map("platform_fee") @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  paymentMethod   String      @default("COD") @map("payment_method")
  codAmount       Decimal?    @map("cod_amount") @db.Decimal(10, 2)
  codCollected    Boolean     @default(false) @map("cod_collected")
  notes           String?     @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deliveredAt     DateTime?   @map("delivered_at")

  // Relations
  shop      Shop?       @relation(fields: [shopId], references: [id])
  rider     User?       @relation(fields: [riderId], references: [id])
  items     OrderItem[]
  feedbacks Feedback[]

  @@index([status])
  @@index([customerPhone])
  @@index([riderId])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  itemId     String   @map("item_id")
  itemName   String   @map("item_name")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Promotion {
  id            String        @id @default(uuid())
  name          String
  type          PromotionType
  value         Decimal       @db.Decimal(10, 2)
  code          String?       @unique
  startsAt      DateTime?     @map("starts_at")
  endsAt        DateTime?     @map("ends_at")
  isActive      Boolean       @default(true) @map("is_active")
  applicableTo  Json          @default("{}") @map("applicable_to")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("promotions")
}

model Banner {
  id           String   @id @default(uuid())
  title        String?
  imageUrl     String   @map("image_url")
  linkType     LinkType @map("link_type")
  linkId       String?  @map("link_id")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model HomeSection {
  id           String      @id @default(uuid())
  sectionType  SectionType @map("section_type")
  title        String?
  displayOrder Int         @default(0) @map("display_order")
  isActive     Boolean     @default(true) @map("is_active")
  config       Json        @default("{}")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("home_sections")
}

model Feedback {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model PlatformConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}
